[Desktop Entry]
Type=Application
Name=Plasma Opus
GenericName=Dual-Pane File Manager
Comment=Dual-pane file manager for KDE Plasma
Exec=@KDE_INSTALL_FULL_BINDIR@/opus-file-manager %U
TryExec=@KDE_INSTALL_FULL_BINDIR@/opus-file-manager
Icon=org.kde.opusfilemanager
Terminal=false
Categories=Qt;KDE;System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folders;manager;explorer;dual;pane;
StartupNotify=true
StartupWMClass=opus-file-manager
DBusActivatable=false
X-DBUS-ServiceName=org.kde.opus-file-manager
X-KDE-StartupNotify=true
