<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <include>QDir</include>
  <include>KIO/PreviewJob</include>
  <include>ignorelist.h</include>
  <include>limits</include>
  <kcfgfile/>
  <group name="Translation">
    <entry name="InterfaceLanguage" type="String">
      <label>Interface language; empty follows the system</label>
      <default></default>
    </entry>
    <entry name="RegionalLocale" type="String">
      <label>Regional format locale; empty follows the system</label>
      <default></default>
    </entry>
    <entry name="TranslationDirection" type="Enum">
      <label>Interface layout direction</label>
      <choices>
        <choice name="FollowLanguage"/>
        <choice name="LeftToRight"/>
        <choice name="RightToLeft"/>
      </choices>
      <default>FollowLanguage</default>
    </entry>
    <entry name="CalendarOverride" type="Enum">
      <label>Calendar used for dates</label>
      <choices>
        <choice name="FollowRegionalLocale"/>
        <choice name="GregorianCalendar"/>
        <choice name="JalaliCalendar"/>
      </choices>
      <default>FollowRegionalLocale</default>
    </entry>
    <entry name="CustomDateFormat" type="String">
      <label>Custom date format; empty uses the listing default</label>
      <default></default>
    </entry>
    <entry name="CustomTimeFormat" type="String">
      <label>Custom time format; empty uses the listing default</label>
      <default></default>
    </entry>
    <entry name="NumeralStyle" type="Enum">
      <label>Digit shapes</label>
      <choices>
        <choice name="LocaleDigits"/>
        <choice name="WesternDigits"/>
        <choice name="EasternArabicIndicDigits"/>
        <choice name="CustomDigits"/>
      </choices>
      <default>LocaleDigits</default>
    </entry>
    <entry name="CustomNumerals" type="String">
      <label>Ten custom digit symbols, in order from zero to nine</label>
      <default>0123456789</default>
    </entry>
  </group>
  <group name="Startup">
    <entry name="StartupMode" type="Enum">
      <label>What the window shows when Plasma Opus starts</label>
      <choices>
        <choice name="RestoreSession"/>
        <choice name="HomeFolder"/>
        <choice name="FixedFolders"/>
      </choices>
      <default>RestoreSession</default>
    </entry>
    <entry name="HomeUrl" type="Url">
      <label>Folder opened by Go Home</label>
      <default code="true">QUrl::fromLocalFile(QDir::homePath())</default>
    </entry>
    <entry name="LeftStartUrl" type="Url">
      <label>Folder of the first pane when starting with fixed folders</label>
      <default code="true">QUrl::fromLocalFile(QDir::homePath())</default>
    </entry>
    <entry name="RightStartUrl" type="Url">
      <label>Folder of the second pane when starting with fixed folders</label>
      <default code="true">QUrl::fromLocalFile(QDir::homePath())</default>
    </entry>
  </group>
  <group name="Panes">
    <entry name="DimInactivePane" type="Bool">
      <label>Dim the inactive pane</label>
      <default>false</default>
    </entry>
    <entry name="InactivePaneOpacity" type="Int">
      <label>Opacity of the inactive pane in percent when dimmed</label>
      <default>65</default>
      <min>20</min>
      <max>100</max>
    </entry>
    <entry name="DualPaneAtStartup" type="Enum">
      <label>Whether the window starts with one or two panes</label>
      <choices>
        <choice name="AsLastUsed"/>
        <choice name="Always"/>
        <choice name="Never"/>
      </choices>
      <default>AsLastUsed</default>
    </entry>
    <entry name="AlwaysShowTabBar" type="Bool">
      <label>Show the tab bars even when each pane has one tab</label>
      <default>true</default>
    </entry>
    <entry name="TabSwitchesPanes" type="Bool">
      <label>The Tab key switches between the panes</label>
      <default>true</default>
    </entry>
    <entry name="NewTabsAfterCurrent" type="Bool">
      <label>Open new tabs next to the current tab instead of at the end</label>
      <default>true</default>
    </entry>
    <entry name="ShowNavigationBar" type="Bool">
      <label>Show the navigation bar of each pane</label>
      <default>true</default>
    </entry>
  </group>
  <group name="Navigation">
    <entry name="FollowSymlinks" type="Bool">
      <label>Show folders opened through a symbolic link at their real location</label>
      <default>false</default>
    </entry>
    <entry name="RestoreHistorySelection" type="Bool"><default>true</default></entry>
    <entry name="RestoreHistoryScroll" type="Bool"><default>true</default></entry>
  </group>
  <group name="FolderSizes">
    <entry name="AutomaticLocalFolderSizes" key="AutomaticLocal" type="Bool"><default>false</default></entry>
    <entry name="AutomaticRemoteFolderSizes" key="AutomaticRemote" type="Bool"><default>false</default></entry>
    <entry name="FolderSizeRefreshInterval" type="Int">
      <label>Refresh calculated folder sizes periodically, in seconds; zero disables refresh</label>
      <default>0</default>
      <min>0</min>
      <max>86400</max>
    </entry>
  </group>
  <group name="Views">
    <entry name="DefaultViewMode" type="Enum">
      <label>View mode of the panes in a new window</label>
      <choices>
        <choice name="Details"/>
        <choice name="Icons"/>
      </choices>
      <default>Details</default>
    </entry>
    <entry name="DetailsIconSize" type="Int">
      <label>Icon size in the details view</label>
      <default>24</default>
      <min>16</min>
      <max>64</max>
    </entry>
    <entry name="IconsIconSize" type="Int">
      <label>Icon and preview size in the icons view</label>
      <default>64</default>
      <min>32</min>
      <max>256</max>
    </entry>
    <entry name="SortColumn" type="Enum">
      <label>Sort key of the panes in a new window</label>
      <choices>
        <choice name="Name"/>
        <choice name="Size"/>
        <choice name="ModifiedTime"/>
        <choice name="Permissions"/>
        <choice name="Owner"/>
        <choice name="Group"/>
        <choice name="Type"/>
      </choices>
      <default>Name</default>
    </entry>
    <entry name="SortDescending" type="Bool">
      <label>Sort in descending order in a new window</label>
      <default>false</default>
    </entry>
    <entry name="FoldersFirst" type="Bool">
      <label>Sort folders before files</label>
      <default>true</default>
    </entry>
    <entry name="ShowHiddenFiles" type="Bool">
      <label>Show hidden files in a new window</label>
      <default>false</default>
    </entry>
    <entry name="ShowToolTips" type="Bool">
      <label>Show the full name of shortened items in a tooltip</label>
      <default>true</default>
    </entry>
    <entry name="ShowFileListMinimap" type="Bool">
      <label>Show a file-list minimap in each pane</label>
      <default>false</default>
    </entry>
    <entry name="FileListMinimapWidth" type="Int">
      <label>Width of the file-list minimap in pixels</label>
      <default>50</default>
      <min>8</min>
      <max>64</max>
    </entry>
    <entry name="ShowSizeColumn" type="Bool">
      <label>Show the Size column</label>
      <default>true</default>
    </entry>
    <entry name="ShowModifiedColumn" type="Bool">
      <label>Show the Modified column</label>
      <default>true</default>
    </entry>
    <entry name="ShowPermissionsColumn" type="Bool">
      <label>Show the Permissions column</label>
      <default>false</default>
    </entry>
    <entry name="ShowOwnerColumn" type="Bool">
      <label>Show the Owner column</label>
      <default>false</default>
    </entry>
    <entry name="ShowGroupColumn" type="Bool">
      <label>Show the Group column</label>
      <default>false</default>
    </entry>
    <entry name="ShowRatingColumn" type="Bool">
      <label>Show Rating instead of the Group column</label>
      <default>false</default>
    </entry>
    <entry name="DetailsDensity" type="Enum">
      <label>Space around items in the details view</label>
      <choices>
        <choice name="Normal"/>
        <choice name="Compact"/>
        <choice name="VeryCompact"/>
        <choice name="Custom"/>
      </choices>
      <default>Normal</default>
    </entry>
    <entry name="DetailsCustomSpace" type="Int">
      <label>Pixels above and below each item in the details view with custom density</label>
      <default>2</default>
      <min>0</min>
      <max>10</max>
    </entry>
    <entry name="IconsDensity" type="Enum">
      <label>Space around items in the icons view</label>
      <choices>
        <choice name="Normal"/>
        <choice name="Compact"/>
        <choice name="VeryCompact"/>
        <choice name="Custom"/>
      </choices>
      <default>Normal</default>
    </entry>
    <entry name="IconsCustomSpace" type="Int">
      <label>Pixels around each item in the icons view with custom density</label>
      <default>2</default>
      <min>0</min>
      <max>10</max>
    </entry>
    <entry name="BarDensity" type="Enum">
      <label>Height of the toolbars, location bars and status bar</label>
      <choices>
        <choice name="Normal"/>
        <choice name="Compact"/>
        <choice name="VeryCompact"/>
        <choice name="Custom"/>
      </choices>
      <default>Normal</default>
    </entry>
    <entry name="BarCustomSpacing" type="Int">
      <label>Custom bar spacing in pixels</label>
      <default>4</default><min>0</min><max>32</max>
    </entry>
    <entry name="ToolbarButtonStyle" type="Enum">
      <label>Default style of toolbar buttons</label>
      <choices>
        <choice name="IconOnly"/>
        <choice name="TextOnly"/>
        <choice name="TextBesideIcon"/>
        <choice name="TextUnderIcon"/>
      </choices>
      <default>IconOnly</default>
    </entry>
    <entry name="ToolbarIconSize" type="Int">
      <label>Toolbar icon size in pixels; zero uses each toolbar's default</label>
      <default>0</default>
      <min>0</min>
      <max>64</max>
    </entry>
    <entry name="LockToolbars" type="Bool">
      <label>Lock toolbar positions and editing</label>
      <default>false</default>
    </entry>
    <entry name="PaneMoveDestination" type="Enum">
      <label>Default destination for a moved second pane</label>
      <choices>
        <choice name="Tab"/>
        <choice name="Window"/>
      </choices>
      <default>Tab</default>
    </entry>
    <entry name="PaneMoveDisplayStyle" type="Enum">
      <label>Display style to use when moving the second pane</label>
      <choices>
        <choice name="Keep"/>
        <choice name="ResetToDefault"/>
      </choices>
      <default>Keep</default>
    </entry>
    <entry name="PaneSwapMode" type="Enum">
      <label>Default pane swapping operation</label>
      <choices>
        <choice name="CurrentTabs"/>
        <choice name="WholeSides"/>
      </choices>
      <default>CurrentTabs</default>
    </entry>
    <entry name="DragFromAnywhere" type="Bool">
      <label>Drag files and folders from anywhere in a details row</label>
      <default>false</default>
    </entry>
    <entry name="ShowTypeColumn" type="Bool">
      <label>Show the Type column</label>
      <default>true</default>
    </entry>
    <entry name="InlineFolderExpansion" type="Bool"><default>true</default></entry>
    <entry name="DetailsColumnWidth" type="Enum">
      <choices><choice name="StretchName"/><choice name="Automatic"/><choice name="Manual"/></choices>
      <default>StretchName</default>
    </entry>
    <entry name="DefaultSelectionMarkers" type="Bool"><default>false</default></entry>
    <entry name="DefaultSelectionMode" type="Bool"><default>false</default></entry>
    <entry name="CompactIconSize" type="Int"><default>16</default><min>16</min><max>64</max></entry>
    <entry name="CompactItemSpacing" type="Int"><default>0</default><min>0</min><max>20</max></entry>
    <entry name="CompactInformation" type="StringList"><default></default></entry>
    <entry name="DefaultFilterScope" type="Enum">
      <choices><choice name="Files"/><choice name="Folders"/><choice name="FilesAndFolders"/></choices>
      <default>Files</default>
    </entry>
    <entry name="FilterTypeAhead" type="Bool"><default>true</default></entry>
    <entry name="RetainFilterOnNavigation" type="Bool"><default>true</default></entry>
    <entry name="HighlightFilterMatches" type="Bool"><default>true</default></entry>
  </group>
  <group name="View">
    <entry name="GroupBy" type="Enum">
      <choices><choice name="none"/><choice name="name"/><choice name="Type" value="type"/><choice name="size"/><choice name="date"/><choice name="ext"/></choices>
      <default>none</default>
    </entry>
    <entry name="SizeFormat" type="Enum">
      <choices><choice name="human"/><choice name="bytes"/></choices>
      <default>human</default>
    </entry>
    <entry name="DateFormat" type="Enum">
      <choices><choice name="locale"/><choice name="iso"/></choices>
      <default>locale</default>
    </entry>
    <entry name="ShowSeconds" type="Bool"><default>false</default></entry>
    <entry name="IconNameLines" type="Int"><default>2</default><min>1</min><max>5</max></entry>
    <entry name="IconInformation" type="StringList"><default></default></entry>
  </group>
  <group name="Previews">
    <entry name="PreviewPlacement" type="Enum">
      <choices><choice name="Pane"/><choice name="Below"/><choice name="Right"/></choices>
      <default>Right</default>
    </entry>
    <entry name="PreviewMediaAutoplay" type="Bool"><default>false</default></entry>
    <entry name="PreviewFormatted" type="Bool"><default>true</default></entry>
    <entry name="PreviewLineNumbers" type="Bool"><default>true</default></entry>
    <entry name="PreviewSyntaxHighlighting" type="Bool"><default>true</default></entry>
    <entry name="ShowPreviews" type="Bool">
      <label>Show previews in a new window</label>
      <default>false</default>
    </entry>
    <entry name="ShowRemotePreviews" type="Bool">
      <label>Show previews in folders that are not on this computer</label>
      <default>false</default>
    </entry>
    <entry name="TextPreviewLimitKiB" type="Int">
      <label>Maximum text preview size in KiB</label>
      <default>1024</default><min>1</min><max>16384</max>
    </entry>
  </group>
  <group name="Terminal">
    <entry name="TerminalFollowActiveFolder" type="Bool"><default>true</default></entry>
    <entry name="TerminalPlacement" type="Enum">
      <label>Position of the embedded terminal</label>
      <choices>
        <choice name="Automatic"/>
        <choice name="Below"/>
        <choice name="Right"/>
      </choices>
      <default>Automatic</default>
    </entry>
  </group>
  <group name="Search">
    <entry name="SearchIndexedByDefault" type="Bool">
      <label>Use indexed locations as the initial search scope</label>
      <default>false</default>
    </entry>
    <entry name="SearchContentsByDefault" type="Bool">
      <label>Search file contents by default</label>
      <default>false</default>
    </entry>
    <entry name="WorkspaceSearchByDefault" type="Bool">
      <label>Limit searches to the active workspace's locations by default</label>
      <default>true</default>
    </entry>
  </group>
  <group name="DuplicateFinder">
    <entry name="DuplicateRequireSameFileName" type="Bool">
      <label>Require identical file names when finding duplicates</label>
      <default>false</default>
    </entry>
    <entry name="DuplicateSelectionPolicy" type="Enum">
      <label>Default duplicate candidate selection policy</label>
      <choices>
        <choice name="KeepNewest"/>
        <choice name="KeepOldest"/>
        <choice name="InFolder"/>
      </choices>
      <default>KeepNewest</default>
    </entry>
  </group>
  <group name="ContentChart">
    <entry name="ContentChartShowTreemap" type="Bool">
      <label>Show the treemap in content charts</label>
      <default>true</default>
    </entry>
    <entry name="ContentChartSort" type="Enum">
      <label>Initial content chart table sorting</label>
      <choices>
        <choice name="AsListed"/>
        <choice name="Name"/>
        <choice name="Size"/>
        <choice name="Share"/>
      </choices>
      <default>AsListed</default>
    </entry>
    <entry name="ContentChartSortDescending" type="Bool">
      <label>Sort content chart entries in descending order</label>
      <default>false</default>
    </entry>
  </group>
  <group name="LinkedPanes">
    <entry name="LinkPanesAtStartup" type="Bool">
      <label>Link initial pane navigation at startup</label>
      <default>true</default>
    </entry>
  </group>
  <group name="FileDiff">
    <entry name="FileDiffWrapLines" type="Bool">
      <label>Wrap file comparison output</label>
      <default>false</default>
    </entry>
  </group>
  <group name="PaneComparison">
    <entry name="PaneComparisonShowLeftOnly" type="Bool"><default>true</default></entry>
    <entry name="PaneComparisonShowRightOnly" type="Bool"><default>true</default></entry>
    <entry name="PaneComparisonShowDifferent" type="Bool"><default>true</default></entry>
    <entry name="PaneComparisonShowMatching" type="Bool"><default>true</default></entry>
  </group>
  <group name="ToolDefaults">
    <entry name="SymlinkSuffix" type="String"><default></default></entry>
    <entry name="ChecksumFileName" type="String"><default>checksums.sha256</default></entry>
    <entry name="SplitPartSizeMiB" type="Int"><default>100</default><min>1</min><max>2147483647</max></entry>
  </group>
  <group name="MetadataEditor">
    <entry name="MetadataPlacement" type="Enum">
      <choices><choice name="Window"/><choice name="Below"/><choice name="Right"/></choices>
      <default>Window</default>
    </entry>
    <entry name="MetadataAudioTitle" type="Bool"><default>true</default></entry>
    <entry name="MetadataAudioArtist" type="Bool"><default>true</default></entry>
    <entry name="MetadataAudioAlbum" type="Bool"><default>true</default></entry>
    <entry name="MetadataImageDescription" type="Bool"><default>true</default></entry>
    <entry name="MetadataImageArtist" type="Bool"><default>true</default></entry>
    <entry name="MetadataImageCopyright" type="Bool"><default>true</default></entry>
  </group>
  <group name="FolderSync">
    <entry name="FolderSyncRecursive" type="Bool"><default>true</default></entry>
    <entry name="FolderSyncCompareContents" type="Bool"><default>false</default></entry>
    <entry name="FolderSyncCompareLinks" type="Bool"><default>false</default></entry>
    <entry name="FolderSyncCopyPolicy" type="Enum">
      <choices><choice name="All"/><choice name="SkipExisting"/><choice name="NewerOnly"/></choices>
      <default>All</default>
    </entry>
    <entry name="FolderSyncSpeedLimitKiB" type="Int"><default>0</default><min>0</min><max>1048576</max></entry>
  </group>
  <group name="ListingExport">
    <entry name="ListingExportFormat" type="Enum">
      <choices><choice name="Csv"/><choice name="Pdf"/></choices>
      <default>Csv</default>
    </entry>
    <entry name="ListingExportCustomColumns" type="Bool"><default>false</default></entry>
    <entry name="ListingExportType" type="Bool"><default>true</default></entry>
    <entry name="ListingExportSize" type="Bool"><default>true</default></entry>
    <entry name="ListingExportModified" type="Bool"><default>true</default></entry>
    <entry name="ListingExportPermissions" type="Bool"><default>false</default></entry>
    <entry name="ListingExportOwner" type="Bool"><default>false</default></entry>
    <entry name="ListingExportGroup" type="Bool"><default>false</default></entry>
  </group>
  <group name="TransferQueue">
    <entry name="TransferQueueEnabled" type="Bool"><default>true</default></entry>
    <entry name="TransferQueueConcurrency" type="Int"><default>1</default><min>1</min><max>16</max></entry>
    <entry name="TransferConflictPolicy" type="Enum">
      <choices><choice name="Ask"/><choice name="Skip"/><choice name="Rename"/><choice name="Overwrite"/></choices>
      <default>Ask</default>
    </entry>
  </group>
  <group name="Editor">
    <entry name="EditorOpening" type="Enum">
      <choices><choice name="Panel"/><choice name="Embedded"/><choice name="Maximized"/><choice name="Window"/></choices>
      <default>Panel</default>
    </entry>
    <entry name="EditorEmbeddedPlacement" type="Enum">
      <choices><choice name="Below"/><choice name="Right"/></choices>
      <default>Below</default>
    </entry>
    <entry name="EditorFontSize" type="Int"><default>12</default><min>6</min><max>72</max></entry>
    <entry name="EditorWordWrap" type="Bool"><default>false</default></entry>
    <entry name="EditorMarkdownMode" type="Enum">
      <choices><choice name="Source"/><choice name="Visual"/></choices>
      <default>Source</default>
    </entry>
    <entry name="EditorDraftsEnabled" type="Bool"><default>true</default></entry>
    <entry name="EditorDraftIntervalMs" type="Int"><default>700</default><min>100</min><max>600000</max></entry>
    <entry name="EditorDraftRetentionDays" type="Int"><default>0</default><min>0</min><max>3650</max></entry>
    <entry name="EditorPdfPageSize" type="Enum">
      <choices><choice name="A4"/><choice name="Letter"/><choice name="Legal"/></choices>
      <default>A4</default>
    </entry>
    <entry name="EditorPdfMarginLeft" type="Int"><default>10</default><min>0</min><max>50</max></entry>
    <entry name="EditorPdfMarginTop" type="Int"><default>10</default><min>0</min><max>50</max></entry>
    <entry name="EditorPdfMarginRight" type="Int"><default>10</default><min>0</min><max>50</max></entry>
    <entry name="EditorPdfMarginBottom" type="Int"><default>10</default><min>0</min><max>50</max></entry>
  </group>
  <group name="Gallery">
    <entry name="ImageBackground" type="Enum">
      <label>Background for transparent images in preview and gallery</label>
      <choices><choice name="Theme"/><choice name="Light"/><choice name="Dark"/><choice name="Checkerboard"/></choices>
      <default>Theme</default>
    </entry>
    <entry name="GalleryInitialZoom" type="Enum">
      <choices><choice name="Fit"/><choice name="ActualSize"/></choices>
      <default>Fit</default>
    </entry>
    <entry name="GalleryShowThumbnails" type="Bool"><default>true</default></entry>
    <entry name="GalleryShowInformation" type="Bool">
      <label>Show image information in new gallery windows</label>
      <default>true</default>
    </entry>
    <entry name="GallerySlideshowInterval" type="Int">
      <label>Slideshow interval in seconds</label>
      <default>3</default><min>1</min><max>3600</max>
    </entry>
    <entry name="GallerySlideshowLoop" type="Bool">
      <label>Repeat the slideshow after the last item</label>
      <default>true</default>
    </entry>
    <entry name="GalleryCopyFormat" type="Enum">
      <label>Default format for saved image copies</label>
      <choices><choice name="Png"/><choice name="Jpeg"/><choice name="Webp"/></choices>
      <default>Png</default>
    </entry>
    <entry name="GalleryCopyQuality" type="Int">
      <label>Default JPEG and WebP image copy quality</label>
      <default>90</default><min>0</min><max>100</max>
    </entry>
    <entry name="GalleryBatchResize" type="Bool"><default>false</default></entry>
    <entry name="GalleryBatchWidth" type="Int"><default>1024</default><min>1</min><max>20000</max></entry>
    <entry name="GalleryBatchHeight" type="Int"><default>1024</default><min>1</min><max>20000</max></entry>
    <entry name="GalleryBatchFormat" type="Enum">
      <choices><choice name="Png"/><choice name="Jpeg"/><choice name="Webp"/></choices>
      <default>Png</default>
    </entry>
    <entry name="GalleryBatchQuality" type="Int"><default>90</default><min>0</min><max>100</max></entry>
    <entry name="GalleryBatchDestination" type="String"><default></default></entry>
  </group>
  <group name="Opening">
    <entry name="FileActivationDestination" type="Enum">
      <label>Where files activated in a pane open</label>
      <choices><choice name="Application"/><choice name="Gallery"/><choice name="Preview"/></choices>
      <default>Preview</default>
    </entry>
  </group>
  <group name="PreviewSettings">
    <entry name="PreviewPlugins" key="Plugins" type="StringList">
      <label>Preview plugins that run, read by KIO</label>
      <default code="true">KIO::PreviewJob::defaultPlugins()</default>
    </entry>
    <entry name="MaximumPreviewSize" key="MaximumSize" type="ULongLong">
      <label>Largest file, in bytes, that gets a preview, read by KIO</label>
      <default code="true">std::numeric_limits&lt;qulonglong&gt;::max()</default>
    </entry>
  </group>
  <group name="Places">
    <entry name="ShowPlaces" type="Bool">
      <label>Show the Places panel</label>
      <default>false</default>
    </entry>
  </group>
  <group name="PanelSettings">
    <entry name="PanelsVisible" key="Visible" type="Bool"><default>true</default></entry>
    <entry name="PanelPosition" key="Position" type="Enum">
      <choices><choice name="left"/><choice name="right"/></choices>
      <default>left</default>
    </entry>
    <entry name="PanelAutoFocus" key="AutoFocus" type="Bool"><default>true</default></entry>
    <entry name="AutoFocusPaneAfterPanelNavigation" type="Bool">
      <label>Focus the active pane after navigating from a panel</label>
      <default>false</default>
    </entry>
    <entry name="PanelTitlesVisible" key="TitlesVisible" type="Bool"><default>false</default></entry>
    <entry name="EmbeddedPanelTitlesVisible" type="Bool"><default>true</default></entry>
    <entry name="FavoritesVisible" type="Bool"><default>true</default></entry>
    <entry name="PlacesVisible" type="Bool"><default>true</default></entry>
    <entry name="FoldersVisible" type="Bool"><default>true</default></entry>
  </group>
  <group name="Tabs">
    <entry name="TabIcons" key="ShowIcons" type="Bool"><default>true</default></entry>
    <entry name="ExpandTabs" key="Expand" type="Bool"><default>true</default></entry>
    <entry name="ShowTabColors" type="Bool"><default>true</default></entry>
    <entry name="ShowTabCloseButtons" type="Bool"><default>true</default></entry>
    <entry name="StackedTabBarsTogether" type="Bool"><default>true</default></entry>
    <entry name="HorizontalFirstTabPosition" type="Int"><default>0</default><min>0</min><max>3</max></entry>
    <entry name="HorizontalSecondTabPosition" type="Int"><default>0</default><min>0</min><max>3</max></entry>
    <entry name="StackedFirstTabPosition" type="Int"><default>0</default><min>0</min><max>3</max></entry>
    <entry name="StackedSecondTabPosition" type="Int"><default>0</default><min>0</min><max>3</max></entry>
  </group>
  <group name="Archives">
    <entry name="DefaultArchiveFormat" key="DefaultFormat" type="Int">
      <default>0</default><min>0</min><max>4</max>
    </entry>
    <entry name="ArchiveOtherPaneByDefault" type="Bool"><default>false</default></entry>
  </group>
  <group name="Files">
    <entry name="IgnoreList" type="StringList"><default code="true">IgnoreList::defaultEntries()</default></entry>
    <entry name="ExtensionColors" type="StringList"><default></default></entry>
    <entry name="ShowFileLabels" type="Bool"><default>true</default></entry>
    <entry name="ShowFileColors" type="Bool"><default>true</default></entry>
    <entry name="ShowFileRatings" type="Bool"><default>true</default></entry>
    <entry name="ShowFilePins" type="Bool"><default>true</default></entry>
    <entry name="PinnedItemsFirst" type="Bool"><default>true</default></entry>
  </group>
  <group name="StatusBar">
    <entry name="StatusBarLayout" type="Enum">
      <label>Whether status indicators are shared or shown separately in each pane</label>
      <choices>
        <choice name="Shared"/>
        <choice name="PerPane"/>
      </choices>
      <default>Shared</default>
    </entry>
    <entry name="StatusBarIndicatorOrder" type="Enum">
      <label>Order of item counts and the free-space indicator</label>
      <choices>
        <choice name="ItemsFirst"/>
        <choice name="FreeSpaceFirst"/>
      </choices>
      <default>ItemsFirst</default>
    </entry>
    <entry name="ShowItemCounts" type="Bool">
      <label>Show the number of items and selected items</label>
      <default>true</default>
    </entry>
    <entry name="ShowSelectionSize" type="Bool">
      <label>Show the total size of the selected files</label>
      <default>true</default>
    </entry>
    <entry name="ShowFreeSpace" type="Bool">
      <label>Show the free space of the current folder's disk</label>
      <default>true</default>
    </entry>
  </group>
  <group name="InformationPanel">
    <entry name="InformationFields" type="StringList">
      <label>Metadata fields to show in the Information panel, in display order</label>
      <default code="true">QStringList{QStringLiteral("friendlyMimeType"),
        QStringLiteral("size"), QStringLiteral("modificationTime"),
        QStringLiteral("permissions"), QStringLiteral("localPathOrUrl")}</default>
    </entry>
    <entry name="InformationHover" type="Bool">
      <label>Show information for the item under the pointer</label>
      <default>true</default>
    </entry>
  </group>
  <group name="Confirmations">
    <entry name="ConfirmClosingMultipleTabs" type="Bool">
      <label>Ask before closing a window that has more than one tab in a pane</label>
      <default>true</default>
    </entry>
    <entry name="ExecutableAction" type="Enum">
      <label>What opening an executable file does</label>
      <choices>
        <choice name="Ask"/>
        <choice name="Open"/>
        <choice name="Run"/>
        <choice name="RunInTerminal"/>
        <choice name="RunInTerminalKeepOpen"/>
      </choices>
      <default>Ask</default>
    </entry>
    <entry name="DropAction" type="Enum">
      <label>What dropping files without a modifier key does</label>
      <choices>
        <choice name="Ask"/>
        <choice name="Copy"/>
        <choice name="Move"/>
      </choices>
      <default>Ask</default>
    </entry>
  </group>
  <group name="ContextMenu">
    <entry name="ShowOpenInNewTab" type="Bool">
      <label>Show Open in New Tab for folders</label>
      <default>true</default>
    </entry>
    <entry name="ShowOpenInOtherPane" type="Bool">
      <label>Show Open in Other Pane for folders</label>
      <default>true</default>
    </entry>
    <entry name="ShowCopyToOtherPane" type="Bool">
      <label>Show Copy to Other Pane</label>
      <default>true</default>
    </entry>
    <entry name="ShowMoveToOtherPane" type="Bool">
      <label>Show Move to Other Pane</label>
      <default>true</default>
    </entry>
    <entry name="ShowDelete" type="Bool">
      <label>Show Delete as well as Move to Trash</label>
      <default>true</default>
    </entry>
    <entry name="ShowOpenTerminal" type="Bool">
      <label>Show Open Terminal Here for folders</label>
      <default>true</default>
    </entry>
    <entry name="ShowCopyPath" type="Bool">
      <label>Show Copy Path</label>
      <default>true</default>
    </entry>
    <entry name="ShowCopyMoveToMenus" type="Bool">
      <label>Show the Copy To and Move To submenus</label>
      <default>false</default>
    </entry>
    <entry name="CopyToSubmenu" type="Bool"><default>false</default></entry>
    <entry name="MoveToSubmenu" type="Bool"><default>false</default></entry>
    <entry name="HiddenContextActions" type="StringList"><default></default></entry>
    <entry name="HiddenServiceActions" type="StringList"><default></default></entry>
  </group>
  <group name="SettingsDialog">
    <entry name="SidebarTitlePosition" type="Enum">
      <label>Where the settings sidebar shows each page's title</label>
      <choices>
        <choice name="Beside"/>
        <choice name="Below"/>
      </choices>
      <default>Beside</default>
    </entry>
    <entry name="SidebarIconSize" type="Int">
      <label>Size of the settings sidebar icons in pixels</label>
      <default>16</default>
      <min>16</min>
      <max>64</max>
    </entry>
  </group>
  <group name="WorkspaceSettings">
    <entry name="StartupWorkspace" type="String">
      <label>Workspace made active at startup: empty for the last used workspace, "none" for no workspace, or a workspace UUID</label>
      <default></default>
    </entry>
    <entry name="WorkspaceRestorePaneArrangement" type="Bool">
      <label>Restore single or dual panes, stacking, pane sizes and second-pane placement when switching workspaces</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceRestoreViews" type="Bool">
      <label>Restore each pane's view mode when switching workspaces</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceRestoreToolbars" type="Bool">
      <label>Restore main and pane toolbar entries when switching workspaces</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceRestorePanels" type="Bool">
      <label>Restore dock and toolbar positions and the preview, editor and terminal panels when switching workspaces</label>
      <default>true</default>
    </entry>
    <entry name="ConfirmWorkspaceLayoutOverwrite" type="Bool">
      <label>Ask before replacing a workspace's saved layout</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceRestoreTabs" type="Bool">
      <label>Restore each pane's tabs, with their pins, locks and names, when switching workspaces</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceRestoreActiveTabs" type="Bool">
      <label>Restore each pane's current tab and the active pane when switching workspaces</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceRestoreFilters" type="Bool">
      <label>Restore each pane's name filter when switching workspaces</label>
      <default>true</default>
    </entry>
    <entry name="ConfirmWorkspaceSwitch" type="Enum">
      <label>When to ask before switching workspaces replaces the current layout, panes and tabs</label>
      <choices>
        <choice name="Always"/>
        <choice name="WhenUnsaved"/>
        <choice name="Never"/>
      </choices>
      <default>WhenUnsaved</default>
    </entry>
    <entry name="WorkspaceRecoveryPrompt" type="Bool">
      <label>Offer to retry when a workspace's locations, providers or panels are unavailable when switching</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceSelectorPlacement" type="Enum">
      <label>Where the active workspace selector appears; Workspaces stays in the View menu</label>
      <choices>
        <choice name="ViewMenu"/>
        <choice name="StatusBar"/>
        <choice name="ViewMenuAndStatusBar"/>
      </choices>
      <default>ViewMenu</default>
    </entry>
    <entry name="ShowWorkspaceUnsavedIndicator" type="Bool">
      <label>Mark the active workspace when the window differs from its saved layout</label>
      <default>true</default>
    </entry>
    <entry name="ConfirmWorkspaceLayoutRestore" type="Bool">
      <label>Ask before returning to the active workspace's saved layout</label>
      <default>true</default>
    </entry>
    <entry name="LeftLocationPresentation" type="Enum">
      <label>How the left or top pane shows its location when no saved choice applies</label>
      <choices>
        <choice name="FullBreadcrumbs"/>
        <choice name="AbbreviatedBreadcrumbs"/>
        <choice name="EditablePath"/>
      </choices>
      <default>FullBreadcrumbs</default>
    </entry>
    <entry name="RightLocationPresentation" type="Enum">
      <label>How the right or bottom pane shows its location when no saved choice applies</label>
      <choices>
        <choice name="FullBreadcrumbs"/>
        <choice name="AbbreviatedBreadcrumbs"/>
        <choice name="EditablePath"/>
      </choices>
      <default>FullBreadcrumbs</default>
    </entry>
    <entry name="WorkspaceDefaultBehaviorMode" type="Enum">
      <label>Which behaviors new workspaces apply when switching to them</label>
      <choices>
        <choice name="All"/>
        <choice name="Selected"/>
        <choice name="None"/>
      </choices>
      <default>All</default>
    </entry>
    <entry name="WorkspaceDefaultLocationPresentation" type="Bool">
      <label>Whether new workspaces with selected behaviors restore location presentation</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceDefaultSearchScope" type="Bool">
      <label>Whether new workspaces with selected behaviors scope searches to their locations</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceDefaultLayout" type="Bool">
      <label>Whether new workspaces with selected behaviors restore the window and panel layout</label>
      <default>true</default>
    </entry>
    <entry name="WorkspaceDefaultPaneTabRestoration" type="Bool">
      <label>Whether new workspaces with selected behaviors restore panes and tabs</label>
      <default>true</default>
    </entry>
  </group>
  <group name="Themes">
    <entry name="ColorScheme" type="String">
      <label>App-local colour scheme: empty follows Plasma, otherwise a bundled preset or an installed colour scheme</label>
      <default></default>
    </entry>
    <entry name="AccentColor" type="String">
      <label>App-local accent colour for selection, focus, progress and tab indicators as #rrggbb; empty follows the colour scheme</label>
      <default></default>
    </entry>
    <entry name="CustomColors" type="StringList">
      <label>App-local palette role colours layered over the colour scheme, as Role=#rrggbb entries</label>
      <default></default>
    </entry>
    <entry name="PaneTint" type="Enum">
      <label>Which panes have a tinted folder view background</label>
      <choices>
        <choice name="None"/>
        <choice name="AllPanes"/>
        <choice name="ActivePane"/>
        <choice name="InactivePane"/>
      </choices>
      <default>None</default>
    </entry>
    <entry name="PaneTintColor" type="Color">
      <label>Colour mixed into the background of tinted panes</label>
      <default>61,174,233</default>
    </entry>
    <entry name="PaneTintStrength" type="Int">
      <label>Percentage of the tint colour mixed into the background of tinted panes, lowered when needed to keep text readable</label>
      <default>10</default>
      <min>1</min>
      <max>50</max>
    </entry>
    <entry name="BackgroundBlur" type="Bool">
      <label>Blur the desktop behind translucent backgrounds with KWin's blur effect</label>
      <default>false</default>
    </entry>
    <entry name="WindowOpacity" type="Int">
      <label>Opacity of the window background in percent, below the panes and panels</label>
      <default>100</default>
      <min>20</min>
      <max>100</max>
    </entry>
    <entry name="PaneOpacity" type="Int">
      <label>Opacity of the folder view background in each pane in percent, layered over the window background</label>
      <default>100</default>
      <min>20</min>
      <max>100</max>
    </entry>
    <entry name="PanelOpacity" type="Int">
      <label>Opacity of docked panel backgrounds in percent, layered over the window background</label>
      <default>100</default>
      <min>20</min>
      <max>100</max>
    </entry>
    <entry name="CornerRadius" type="Enum">
      <label>Corner radius of item highlights, input fields, tabs and tooltips</label>
      <choices>
        <choice name="FollowStyle"/>
        <choice name="None"/>
        <choice name="Small"/>
        <choice name="Medium"/>
        <choice name="Large"/>
        <choice name="Custom"/>
      </choices>
      <default>FollowStyle</default>
    </entry>
    <entry name="CustomCornerRadius" type="Int">
      <label>Corner radius in logical pixels when the corner radius is custom</label>
      <default>6</default>
      <min>0</min>
      <max>24</max>
    </entry>
    <entry name="Dividers" type="Enum">
      <label>How splitter handles, panel and toolbar separators, header and grid lines and pane frames are drawn</label>
      <choices>
        <choice name="FollowStyle"/>
        <choice name="Thin"/>
        <choice name="Hidden"/>
      </choices>
      <default>FollowStyle</default>
    </entry>
    <entry name="RevealDividersOnHover" type="Bool">
      <label>Whether hidden splitter handles and panel separators appear while the pointer is over them</label>
      <default>true</default>
    </entry>
  </group>
</kcfg>
